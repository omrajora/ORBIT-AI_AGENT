# ORBIT Environment Configuration
NODE_ENV=development

# Server Ports
PORT=3001
MCP_PORT=3002
VITE_API_URL=http://localhost:3001
VITE_MCP_URL=http://localhost:3002

# Database File
SQLITE_DB_PATH=./data/orbit.sqlite

# AI Provider Configuration
# Supported: deterministic-smart, gemini, openai
# 'deterministic-smart' guarantees 100% reliable execution for judge testing and the flagship workflow
AGENT_PROVIDER=deterministic-smart

# Optional API Keys (if using cloud providers)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Execution Limits
MAX_AGENT_ITERATIONS=5
TOOL_TIMEOUT_MS=15000
APPROVAL_TTL_SECONDS=300
